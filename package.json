{
    "name": "vital-react-native",
    "version": "0.1.0",
    "description": "React Native Components",
    "source": "./src/index.tsx",
    "main": "./lib/module/index.js",
    "types": "./lib/typescript/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/typescript/src/index.d.ts",
            "default": "./lib/module/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "lib",
        "android",
        "ios",
        "cpp",
        "*.podspec",
        "react-native.config.js",
        "!ios/build",
        "!android/build",
        "!android/gradle",
        "!android/gradlew",
        "!android/gradlew.bat",
        "!android/local.properties",
        "!**/__tests__",
        "!**/__fixtures__",
        "!**/__mocks__",
        "!**/.*"
    ],
    "scripts": {
        "example": "yarn workspace vital-react-native-example",
        "test": "jest",
        "typecheck": "tsc",
        "lint": "eslint \"**/*.{js,ts,tsx}\"",
        "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
        "prepare": "bob build",
        "release": "release-it"
    },
    "keywords": [
        "react-native",
        "ios",
        "android"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sgoel1495/vital-react-native.git"
    },
    "author": "shubhamgoel <shubham.goel1495@gmail.com> (https://github.com/sgoel1495)",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/sgoel1495/vital-react-native/issues"
    },
    "homepage": "https://github.com/sgoel1495/vital-react-native#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "^19.6.0",
        "@eslint/compat": "^1.2.7",
        "@eslint/eslintrc": "^3.3.0",
        "@eslint/js": "^9.22.0",
        "@evilmartians/lefthook": "^1.5.0",
        "@react-native-community/cli": "15.0.1",
        "@react-native/eslint-config": "^0.78.0",
        "@release-it/conventional-changelog": "^9.0.2",
        "@types/jest": "^29.5.5",
        "@types/react": "^19.0.0",
        "@typescript-eslint/eslint-plugin": "^8.34.1",
        "@typescript-eslint/parser": "^8.34.1",
        "commitlint": "^19.6.1",
        "del-cli": "^5.1.0",
        "eslint": "^9.22.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-native": "^5.0.0",
        "globals": "^16.2.0",
        "jest": "^29.7.0",
        "prettier": "^3.0.3",
        "react": "19.0.0",
        "react-native": "0.78.2",
        "react-native-builder-bob": "^0.40.5",
        "release-it": "^17.10.0",
        "turbo": "^1.10.7",
        "typescript": "^5.2.2"
    },
    "peerDependencies": {
        "@react-native-masked-view/masked-view": "^0.2.9",
        "react": "*",
        "react-native": "*",
        "react-native-gesture-handler": "^2.5.0",
        "react-native-linear-gradient": "^2.6.2",
        "react-native-reanimated": "^3.4.2",
        "react-native-safe-area-context": "^4.3.1",
        "react-native-svg": "^12.3.0",
        "react-native-svg-transformer": "^1.0.0"
    },
    "workspaces": [
        "example"
    ],
    "packageManager": "yarn@3.6.1",
    "jest": {
        "preset": "react-native",
        "modulePathIgnorePatterns": [
            "<rootDir>/example/node_modules",
            "<rootDir>/lib/"
        ]
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "release-it": {
        "git": {
            "commitMessage": "chore: release ${version}",
            "tagName": "v${version}"
        },
        "npm": {
            "publish": true
        },
        "github": {
            "release": true
        },
        "plugins": {
            "@release-it/conventional-changelog": {
                "preset": {
                    "name": "angular"
                }
            }
        }
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            "codegen",
            [
                "module",
                {
                    "esm": true
                }
            ],
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ]
    },
    "codegenConfig": {
        "name": "RNVitalReactNativeSpec",
        "type": "modules",
        "jsSrcsDir": "src",
        "outputDir": {
            "ios": "ios/generated",
            "android": "android/generated"
        },
        "android": {
            "javaPackageName": "com.vitalreactnative"
        },
        "includesGeneratedCode": true
    },
    "create-react-native-library": {
        "type": "turbo-module",
        "languages": "kotlin-objc",
        "version": "0.49.8"
    }
}
